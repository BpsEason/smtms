APP_ENV=development
APP_NAME=SMTMS
APP_DEBUG=true
API_V1_STR=/api/v1
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
SMTMS_SEED_PASSWORD=replace-with-local-test-password-at-least-12-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# MySQL is external to the Compose stack. Use localhost for direct backend runs;
# inside Docker Desktop, use host.docker.internal to reach host MySQL.
DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/smtms
REDIS_URL=redis://127.0.0.1:6379/0
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
DOCUMENT_STORAGE_DIR=var/documents
DOCUMENT_MAX_FILE_BYTES=10485760
